# Banco de dados PostgreSQL
DATABASE_URL="https://vercel.com/afrontosos-projects/controle-financeiro/settings/environment-variables"

# NextAuth
# Gere um segredo com: openssl rand -base64 32
NEXTAUTH_SECRET="1234567890"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > APIs e Serviços > Credenciais)
GOOGLE_CLIENT_ID="https://vercel.com/afrontosos-projects/controle-financeiro/settings/environment-variables"
GOOGLE_CLIENT_SECRET="https://vercel.com/afrontosos-projects/controle-financeiro/settings/environment-variables"

# Sugestões do menu (resend.com > API Keys). Sem as duas primeiras, o envio
# responde erro e a sugestão não sai do app.
RESEND_API_KEY="re_xxxxxxxx"
SUGGESTIONS_EMAIL="seu-email-pessoal@gmail.com"
# Remetente. Só aceita um domínio verificado no Resend; sem isso, deixe o padrão.
SUGGESTIONS_FROM="onboarding@resend.dev"

# Doação por pix. Vão para o cliente (NEXT_PUBLIC_), então use dados que você
# não se importa de expor — o nome do recebedor aparece no código. Vazias as
# duas, a opção some do menu.
# O payload é o "copia e cola" do seu banco: vira o QR Code e o botão de copiar.
NEXT_PUBLIC_PIX_PAYLOAD=""
NEXT_PUBLIC_PIX_KEY=""
