generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime
  description String
  amount      Float
  type        String   @default("saida")
  isForecast  Boolean  @default(false)
  category    String
  groupId     String?
  createdAt   DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Só faz sentido em lançamentos do tipo "cartao": desloca a cobrança para o
  // vencimento da fatura. Sem cartão, o gasto sai no próprio dia.
  cardId      String?
  card        Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  /// Quem gerou o lançamento quando não foi digitado à mão, ex.: "apto:construtora".
  /// Permite refazer os lançamentos de um plano sem tocar nos manuais.
  source      String?

  @@index([userId])
  @@index([groupId])
  @@index([cardId])
  @@index([userId, source])
}

model Card {
  id        String   @id @default(uuid())
  name      String
  /// Dia do mês em que a fatura vence (1–31; meses curtos usam o último dia).
  dueDay    Int      @default(10)
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid())
  name      String
  amount    Float
  divideBy  Int      @default(30)
  createdAt DateTime @default(now())
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Plano de compra de um imóvel: premissas do contrato e do financiamento.
/// Fica em JSON porque os campos ainda vão mudar muito; quem valida é src/lib/apartment.ts.
model ApartmentPlan {
  id        String   @id @default(uuid())
  premises  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  transactions  Transaction[]
  budgets       Budget[]
  cards         Card[]
  apartmentPlan ApartmentPlan?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
