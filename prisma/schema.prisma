generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime
  description String
  amount      Float
  type        String   @default("saida")
  isForecast  Boolean  @default(false)
  category    String
  groupId     String?
  createdAt   DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Só faz sentido em lançamentos do tipo "cartao": desloca a cobrança para o
  // vencimento da fatura. Sem cartão, o gasto sai no próprio dia.
  cardId      String?
  card        Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  /// Quem gerou o lançamento quando não foi digitado à mão, ex.: "apto:construtora".
  /// Permite refazer os lançamentos de um plano sem tocar nos manuais.
  source      String?

  /// Economia guardada neste cofre, ou entrada resgatada dele.
  vaultId     String?
  vault       Vault?   @relation(fields: [vaultId], references: [id], onDelete: SetNull)

  /// Quando foi marcado como pago. Só um registro: o saldo projetado não muda.
  paidAt      DateTime?

  @@index([userId])
  @@index([groupId])
  @@index([cardId])
  @@index([vaultId])
  @@index([userId, source])
}

model Card {
  id        String   @id @default(uuid())
  name      String
  /// Dia do mês em que a fatura vence (1–31; meses curtos usam o último dia).
  dueDay    Int      @default(10)
  /// Limite de crédito; null = não informado.
  limit     Float?
  /// Conta de cartão no Open Finance (Pluggy) que corresponde a este cartão.
  pluggyAccountId String?
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid())
  name      String
  amount    Float
  divideBy  Int      @default(30)
  createdAt DateTime @default(now())
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Dinheiro separado para um fim: reserva de emergência, notebook, viagem...
/// O saldo é `initial` + economias ligadas − entradas (resgates) ligadas.
model Vault {
  id        String   @id @default(uuid())
  name      String
  /// Meta em reais; null = cofre sem meta.
  goal      Float?
  /// Meta automática: N meses do custo de vida fixo. Quando presente, vale no lugar de `goal`.
  goalMonths Int?
  /// Quanto já havia guardado quando o cofre foi criado no app.
  initial   Float    @default(0)
  /// "reserva" marca a reserva de emergência (no máximo uma por usuário, na prática).
  kind      String   @default("cofre")
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId])
}

/// Transação lida do banco pelo Open Finance (Pluggy), antes de virar lançamento.
/// A caixa de entrada é o que está "pending"; o resto fica para histórico e para
/// não importar duas vezes.
model BankTransaction {
  /// Id da transação na Pluggy: garante que a mesma não entra duas vezes.
  id               String   @id
  itemId           String
  accountId        String
  /// "BANK" (conta) ou "CREDIT" (cartão), como a Pluggy manda.
  accountType      String
  accountName      String
  /// Dia da transação no fuso de Brasília.
  date             DateTime
  description      String
  /// Valor com o sinal da Pluggy: na conta, negativo sai; no cartão, positivo é compra.
  amount           Float
  /// "DEBIT" ou "CREDIT", como a Pluggy manda.
  direction        String
  operationType    String?
  category         String?
  installmentNumber Int?
  totalInstallments Int?
  /// PENDING ou POSTED no banco.
  bankStatus       String?
  /// pending (caixa de entrada) | imported | linked | ignored | history
  status           String   @default("pending")
  /// Por que foi ignorada automaticamente (transferência entre contas, fatura...).
  reason           String?
  /// Lançamento criado ou reconhecido a partir desta transação.
  transactionId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Último retrato das contas no Open Finance: saldos, cartões, cofrinhos,
/// investimentos e validade do consentimento. Substituído a cada sincronização.
model BankSnapshot {
  id        String   @id @default(uuid())
  data      Json
  syncedAt  DateTime @default(now())

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Plano de compra de um imóvel: premissas do contrato e do financiamento.
/// Fica em JSON porque os campos ainda vão mudar muito; quem valida é src/lib/apartment.ts.
model ApartmentPlan {
  id        String   @id @default(uuid())
  premises  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Preferências de tela (apartamento ligado, ordem da barra lateral).
  settings      Json?
  accounts      Account[]
  sessions      Session[]
  
  transactions  Transaction[]
  budgets       Budget[]
  cards         Card[]
  apartmentPlan ApartmentPlan?
  vaults        Vault[]
  bankTransactions BankTransaction[]
  bankSnapshot  BankSnapshot?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
